{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "router",
  "agent": {
    "checker": {
      "mode": "subagent",
      "model": "openai/gpt-4.1-mini",
      "prompt": "{file:.opencode/agents/checker.md}"
    },
    "merger": {
      "mode": "subagent",
      "model": "openai/gpt-4.1",
      "prompt": "{file:.opencode/agents/merger.md}"
    },
    "reproducer": {
      "mode": "subagent",
      "model": "openai/o3",
      "prompt": "{file:.opencode/agents/reproducer.md}"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "openai/o3",
      "prompt": "{file:.opencode/agents/reviewer.md}"
    },
    "router": {
      "mode": "primary",
      "model": "openai/gpt-5",
      "prompt": "{file:.opencode/agents/router.md}"
    },
    "teammate": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "prompt": "{file:.opencode/agents/teammate.md}"
    },
    "tester": {
      "mode": "subagent",
      "model": "openai/gpt-4.1-mini",
      "prompt": "{file:.opencode/agents/tester.md}"
    },
    "watchdog": {
      "mode": "subagent",
      "model": "openai/gpt-4.1-mini",
      "prompt": "{file:.opencode/agents/watchdog.md}"
    },
    "worker": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "prompt": "{file:.opencode/agents/worker.md}"
    }
  }
}