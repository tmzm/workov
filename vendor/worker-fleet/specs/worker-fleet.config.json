{
  "version": "4.0.0",
  "harness": "both",
  "preset": "hybrid-bridge",
  "concurrency": {
    "maxParallelWorkers": 8,
    "mainPort": 3000,
    "reproducerPort": 3090,
    "workerBasePort": 3101,
    "dashboardPort": 3081
  },
  "watchdog": {
    "intervalMinutes": 10,
    "stallThresholdMinutes": 15,
    "autoCompactWindow": 150000,
    "mode": "script",
    "intervalSeconds": 60
  },
  "regression": {
    "everyNMerges": 1
  },
  "models": {
    "router": {
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "opencode": {
        "model": "openai/gpt-5",
        "reasoningEffort": "high"
      }
    },
    "worker": {
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "opencode": {
        "model": "anthropic/claude-sonnet-4-5",
        "reasoningEffort": "high"
      },
      "delegateCli": "none"
    },
    "teammate": {
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "opencode": {
        "model": "anthropic/claude-sonnet-4-5",
        "reasoningEffort": "high"
      }
    },
    "reviewer": {
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "opencode": {
        "model": "openai/o3",
        "reasoningEffort": "high"
      },
      "delegateCli": "codex"
    },
    "reproducer": {
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "opencode": {
        "model": "openai/o3",
        "reasoningEffort": "high"
      }
    },
    "tester": {
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "opencode": {
        "model": "openai/gpt-4.1-mini"
      }
    },
    "merger": {
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "opencode": {
        "model": "openai/gpt-4.1"
      }
    },
    "checker": {
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "opencode": {
        "model": "openai/gpt-4.1-mini"
      }
    },
    "watchdog": {
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "opencode": {
        "model": "openai/gpt-4.1-mini"
      }
    }
  },
  "dashboard": {
    "enabled": true,
    "autoStartWithRouter": true,
    "port": 3081,
    "allowRemoteActions": true,
    "tunnel": {
      "provider": "cloudflared",
      "namedTunnel": ""
    }
  },
  "notifications": {
    "providers": [
      {
        "type": "telegram",
        "botToken": {
          "secretRef": "telegram-1"
        },
        "chatId": "795930517",
        "events": "all"
      }
    ]
  },
  "telemetry": {
    "rates": {
      "opus": {
        "in": 15.0,
        "out": 75.0,
        "cache": 1.5
      },
      "sonnet": {
        "in": 3.0,
        "out": 15.0,
        "cache": 0.3
      },
      "haiku": {
        "in": 0.8,
        "out": 4.0,
        "cache": 0.08
      },
      "gpt-5": {
        "in": 5.0,
        "out": 20.0,
        "cache": 1.25
      },
      "o3": {
        "in": 10.0,
        "out": 40.0,
        "cache": 2.5
      },
      "gpt-4.1-mini": {
        "in": 0.15,
        "out": 0.6,
        "cache": 0.075
      },
      "deepseek": {
        "in": 0.14,
        "out": 0.28,
        "cache": 0.014
      },
      "gpt-4.1": {
        "in": 2.0,
        "out": 8.0,
        "cache": 0.5
      }
    }
  },
  "budget": {
    "defaults": {
      "usd": 10.0,
      "turns": 300
    }
  },
  "landing": "direct"
}